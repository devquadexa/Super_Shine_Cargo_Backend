# Server Configuration
PORT=5000
NODE_ENV=production

# Database Type: mysql or mssql
DB_TYPE=mysql

# MySQL Database Configuration
# NOTE FOR VERCEL DEPLOYMENT:
# Vercel serverless functions cannot connect to 'localhost'.
# You MUST use a publicly accessible cloud MySQL database (e.g., Aiven, PlanetScale, Railway, AWS RDS, TiDB Cloud, etc.)
DB_HOST=your-cloud-mysql-host.example.com
DB_PORT=3306
DB_NAME=super_shine_cargo
DB_USER=your_db_username
DB_PASSWORD=your_db_password
# DB_SSL=true (automatically enabled for remote hosts, set to 'false' only if your cloud provider forbids SSL)
DB_SSL=true

# MSSQL Database Configuration (Legacy / Fallback)
DB_SERVER=your-mssql-server
DB_PORT=1433
DB_DATABASE=SuperShineCargoDb
DB_USER=SUPER_SHINE_CARGO
DB_PASSWORD=your_mssql_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
